# .streamlit/secrets.toml.example
# 실제 값을 채운 secrets.toml은 커밋하지 않는다.
# Streamlit Community Cloud에서는 이 내용을 앱 설정의 Secrets 칸에 붙여넣는다.

[auth]
redirect_uri = "https://<앱이름>.streamlit.app/oauth2callback"
cookie_secret = "<충분히 긴 임의 문자열>"
# 앱이 st.login()을 provider 이름 없이 호출한다(report_dashboard/auth.py:103).
# 이 경우 Streamlit은 [auth.google] 같은 하위 테이블을 보지 않고 이 [auth]
# 테이블에서 바로 client_id/client_secret/server_metadata_url을 읽는다.
# 그래서 아래 세 값은 하위 섹션으로 옮기면 안 되고 반드시 여기 flat하게 둔다.
client_id = "<Google OAuth 클라이언트 ID>"
client_secret = "<Google OAuth 클라이언트 시크릿>"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[auth_roles]
# 우리 팀 계정. 여기 있는 계정만 등록·관리자 페이지에 들어갈 수 있다.
team_emails = ["hw.lee@madup.com"]

[sheets]
# 사람이 미리 만든 스프레드시트의 ID. 서비스 계정에 편집 권한을 줘야 한다.
spreadsheet_id = "<스프레드시트 ID>"

[gcp_service_account]
# 서비스 계정 JSON 키의 내용을 그대로 옮긴다.
type = "service_account"
project_id = "<...>"
private_key_id = "<...>"
private_key = "<...>"
client_email = "<...>@<...>.iam.gserviceaccount.com"
client_id = "<...>"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
