# .streamlit/secrets.toml.example
# 실제 값을 채운 secrets.toml은 커밋하지 않는다.
# Streamlit Community Cloud에서는 이 내용을 앱 설정의 Secrets 칸에 붙여넣는다.

[auth]
redirect_uri = "https://<앱이름>.streamlit.app/oauth2callback"
cookie_secret = "<충분히 긴 임의 문자열>"
# 앱이 st.login()을 provider 이름 없이 호출한다(report_dashboard/auth.py:103).
# 이 경우 Streamlit은 [auth.google] 같은 하위 테이블을 보지 않고 이 [auth]
# 테이블에서 바로 client_id/client_secret/server_metadata_url을 읽는다.
# 그래서 아래 세 값은 하위 섹션으로 옮기면 안 되고 반드시 여기 flat하게 둔다.
client_id = "<Google OAuth 클라이언트 ID>"
client_secret = "<Google OAuth 클라이언트 시크릿>"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[auth_roles]
# 우리 팀 계정. 여기 있는 계정만 등록·관리자 페이지에 들어갈 수 있다.
team_emails = ["hw.lee@madup.com"]

[github]
# 요약 페이지 "지금 수집" 버튼(report_dashboard/gh_actions.py)이 쓴다 — 두 수집
# 워크플로(naver-rank-collect.yml·comment-collect.yml)의 workflow_dispatch를
# REST API로 트리거하는 용도. bc1-viral-report 저장소 하나에만, Actions
# 읽기/쓰기 권한만 준 fine-grained PAT을 발급해서 넣는다(저장소 전체 권한 X).
# 이 값이 없으면 버튼을 눌러도 에러 메시지만 뜨고 아무 요청도 안 나간다 — 기존
# 자동 스케줄·`gh workflow run` 수동 트리거는 이 설정과 무관하게 그대로 작동한다.
token = "<bc1-viral-report 전용 fine-grained PAT>"

[sheets]
# 사람이 미리 만든 스프레드시트의 ID. 서비스 계정에 편집 권한을 줘야 한다.
spreadsheet_id = "<스프레드시트 ID>"

[gcp_service_account]
# 서비스 계정 JSON 키의 내용을 그대로 옮긴다.
type = "service_account"
project_id = "<...>"
private_key_id = "<...>"
private_key = "<...>"
client_email = "<...>@<...>.iam.gserviceaccount.com"
client_id = "<...>"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"

# Plan 3(네이버 순위 자동 수집기)는 이 파일이 아니라 GitHub Actions Secrets에서
# NAVER_CLIENT_ID/NAVER_CLIENT_SECRET을 환경변수로 받는다(.github/workflows/
# naver-rank-collect.yml 참고) — 이 앱(Streamlit)이 직접 쓰는 값이 아니라서
# 여기 [naver] 섹션은 없다. 로컬에서 수집 스크립트를 손으로 돌려볼 때만
# `export NAVER_CLIENT_ID=... NAVER_CLIENT_SECRET=...`로 채운다.

# Plan 4(댓글 자동 수집기)는 GitHub Actions Secrets에서 NAVER_CAFE_COOKIE를
# 환경변수로 받는다(.github/workflows/comment-collect.yml 참고) — 이 앱이
# 직접 쓰는 값이 아니라서 여기 섹션은 없다. 이 쿠키는 팀 전용 네이버 계정의
# 로그인 세션이다 — 아이디·비밀번호 원문은 어디에도 남기지 않는다. 로컬에서
# 손으로 돌려볼 때만 `export NAVER_CAFE_COOKIE='NID_AUT=...; NID_SES=...'`로 채운다.
